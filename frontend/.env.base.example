VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base
VITE_EXPLORER_URL=https://basescan.org
# VITE_AQUA sengaja kosong: alamat resmi diambil dari @1inch/aqua-sdk
# VITE_SWAP_VM_ROUTER kosong: router kita belum ter-deploy di Base
# Naikkan kalau RPC-mu berbayar; RPC publik Base menolak jauh sebelum ini.
VITE_MARKETS_LOOKBACK_BLOCKS=45000

# Model bisnisnya: potongan kecil ke treasury, dipungut di swap yang sama lewat
# opcode AQUA_PROTOCOL_FEE_IN (28) — instruksi yang sama yang dipakai router
# SwapVM resmi 1inch di Base. Kosongkan dan instruksinya tidak disisipkan sama
# sekali. 500000 = 0,05%.
VITE_TREASURY=
VITE_PROTOCOL_FEE_BPS=500000
