# Demo di atas fork Base mainnet — kontrak Aqua RESMI, tanpa uang sungguhan.
#
#   anvil --fork-url https://mainnet.base.org --port 8546 --chain-id 8453
#   cd contracts && ./script/fork-demo.sh
#   cp .env.fork.example .env.local   # lalu isi VITE_SWAP_VM_ROUTER dari keluarannya
#
VITE_CHAIN_ID=8453
VITE_CHAIN_NAME=Base fork
VITE_RPC_URL=http://127.0.0.1:8546
VITE_EXPLORER_URL=https://basescan.org
VITE_AQUA=0x1111113CCf1426A8E30e2bfF5E005d929bF6a90a
VITE_SWAP_VM_ROUTER=0x5Cf2bd1d329075aD57a29bFFcaC63E473b65E853
VITE_DESK_MAKER=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
VITE_DESK_SURCHARGE_BPS=50000000
VITE_WETH_ADDRESS=0x4200000000000000000000000000000000000006
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Fork mulai dari blok mainnet terkini, jadi cukup sapu blok baru saja.
VITE_MARKETS_LOOKBACK_BLOCKS=200
