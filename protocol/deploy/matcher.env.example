# Basis URL RPC untuk jaringan target.
IQIA_RPC_URL=https://sepolia.base.org

# Chain id target. Base Sepolia = 84532, Base mainnet = 8453.
IQIA_CHAIN_ID=84532

# Kunci privat hot wallet matcher yang membayar gas.
# JANGAN pakai kunci yang memegang dana sungguhan.
IQIA_MATCHER_PRIVATE_KEY=0x

# Alamat kontrak IqiaPool.
IQIA_POOL_ADDRESS=0x

# Alamat router SwapVM custom, sekaligus Aqua app. Lihat docs/migrasi.md.
IQIA_SWAP_VM_ROUTER=0x

# Alamat registry Aqua.
IQIA_AQUA_ADDRESS=0x

# Port HTTP yang didengarkan matcher.
IQIA_MATCHER_PORT=8787
